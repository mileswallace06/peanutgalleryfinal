{
  "name": "Purchase",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "buyer_email": "{{user.email}}"
        },
        {
          "seller_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "FK to Listing"
    },
    "event_id": {
      "type": "string",
      "description": "FK to Event"
    },
    "buyer_email": {
      "type": "string",
      "description": "Authoritative buyer identity. Derived server-side from the authenticated user at checkout \u2014 never from frontend input."
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "seller_email": {
      "type": "string",
      "description": "Copied from Listing at time of purchase"
    },
    "amount": {
      "type": "number",
      "description": "Total USD charged to buyer (including platform fee)"
    },
    "subtotal": {
      "type": "number",
      "description": "Ticket price before platform fee"
    },
    "platform_fee": {
      "type": "number",
      "description": "Platform fee collected by Peanut Gallery (USD)"
    },
    "seller_payout": {
      "type": "number",
      "description": "Amount owed to seller after platform fee (USD)"
    },
    "quantity": {
      "type": "number"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID",
      "rls": {
        "read": {
          "$or": [
            {
              "buyer_email": "{{user.email}}"
            },
            {
              "seller_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "payment_captured": {
      "type": "boolean",
      "default": false
    },
    "payment_capture_failed": {
      "type": "boolean",
      "default": false,
      "description": "Set true if Stripe capture attempt failed \u2014 requires admin retry"
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "pending_transfer",
        "completed",
        "expired",
        "disputed"
      ],
      "default": "pending_transfer"
    },
    "buyer_confirmed": {
      "type": "boolean",
      "default": false
    },
    "seller_confirmed": {
      "type": "boolean",
      "default": false
    },
    "seller_confirmed_at": {
      "type": "string",
      "description": "ISO timestamp when seller confirmed transfer \u2014 used for buyer reminder cadence"
    },
    "transfer_notes": {
      "type": "string"
    },
    "transfer_proof_url": {
      "type": "string"
    },
    "dispute_reason": {
      "type": "string"
    },
    "buyer_lat": {
      "type": "number"
    },
    "buyer_lng": {
      "type": "number"
    },
    "location_verified": {
      "type": "boolean",
      "default": false
    },
    "reminder_flags": {
      "type": "object",
      "description": "Tracks which reminder notifications have been sent to prevent duplicates",
      "properties": {
        "seller_r1": {
          "type": "boolean"
        },
        "seller_r2": {
          "type": "boolean"
        },
        "buyer_r1": {
          "type": "boolean"
        },
        "buyer_r2": {
          "type": "boolean"
        },
        "stale_pi_warned": {
          "type": "boolean"
        }
      }
    },
    "auto_review_flagged": {
      "type": "boolean",
      "default": false,
      "description": "Set true when buyer is inactive 24h after seller confirms OR AI flags suspicious proof"
    },
    "auto_review_flagged_at": {
      "type": "string",
      "description": "ISO timestamp when auto_review_flagged was set"
    },
    "false_claim_recorded": {
      "type": "boolean",
      "default": false,
      "description": "Dedup flag \u2014 true once a transfer_false_claim_count strike has been issued for this purchase. Prevents AI rejection + admin rejection + dispute from all counting separately."
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "awaiting_pg_transfer",
        "transfer_in_progress",
        "fulfilled",
        "buyer_confirmed",
        "issue_reported"
      ],
      "description": "Tracks PG fulfillment state for instant listing purchases"
    },
    "fulfillment_proof_url": {
      "type": "string",
      "description": "Admin-uploaded proof of ticket transfer to buyer"
    },
    "fulfillment_notes": {
      "type": "string",
      "description": "Admin notes on fulfillment action"
    },
    "fulfillment_started_at": {
      "type": "string",
      "description": "ISO timestamp when PG marked transfer started"
    },
    "fulfillment_completed_at": {
      "type": "string",
      "description": "ISO timestamp when PG marked transfer complete"
    },
    "ai_proof_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "verified_high_confidence",
        "verified_medium_confidence",
        "needs_human_review",
        "rejected_suspicious",
        "failed_processing"
      ],
      "default": "pending",
      "description": "AI verification status of seller's transfer proof"
    },
    "ai_confidence_score": {
      "type": "number",
      "description": "AI confidence score 0-100"
    },
    "ai_review_notes": {
      "type": "string",
      "description": "AI plain-language summary of the verification decision"
    },
    "ai_detected_platform": {
      "type": "string",
      "enum": [
        "ticketmaster",
        "seatgeek",
        "axs",
        "stubhub",
        "apple_wallet",
        "vivid",
        "screenshot_unknown",
        "other"
      ],
      "description": "Ticketing platform detected in the screenshot"
    },
    "ai_extracted_event_name": {
      "type": "string",
      "description": "Event name extracted from screenshot"
    },
    "ai_extracted_recipient": {
      "type": "string",
      "description": "Recipient email or name extracted from screenshot"
    },
    "ai_extracted_transfer_time": {
      "type": "string",
      "description": "Transfer timestamp extracted from screenshot"
    },
    "ai_extracted_section": {
      "type": "string"
    },
    "ai_extracted_row": {
      "type": "string"
    },
    "ai_extracted_seats": {
      "type": "string"
    },
    "ai_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of AI-detected suspicion flags"
    },
    "ai_processed_at": {
      "type": "string",
      "description": "ISO timestamp when AI processed the proof"
    },
    "ai_processed_by_model": {
      "type": "string",
      "description": "AI model used for verification"
    },
    "fraud_risk_score": {
      "type": "number",
      "description": "Computed fraud risk score 0-100. Higher = more suspicious."
    },
    "admin_override_status": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "escalated",
        "marked_fraudulent"
      ],
      "description": "Admin override of AI decision"
    },
    "admin_override_reason": {
      "type": "string",
      "description": "Admin's reason for overriding AI decision"
    },
    "admin_override_by": {
      "type": "string",
      "description": "Email of admin who performed the override"
    },
    "admin_override_at": {
      "type": "string",
      "description": "ISO timestamp of admin override"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True for simulated demo-upgrade purchases. Demo records never affect real revenue, points, trust, transfer intelligence, or operational analytics."
    }
  },
  "required": [
    "listing_id",
    "event_id",
    "amount"
  ]
}