{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "FK to Listing"
    },
    "event_id": {
      "type": "string",
      "description": "FK to Event"
    },
    "buyer_email": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_phone": {
      "type": "string"
    },
    "seller_email": {
      "type": "string",
      "description": "Copied from Listing at time of purchase"
    },
    "amount": {
      "type": "number",
      "description": "Total USD charged to buyer (including platform fee)"
    },
    "subtotal": {
      "type": "number",
      "description": "Ticket price before platform fee"
    },
    "platform_fee": {
      "type": "number",
      "description": "Platform fee collected by Peanut Gallery (USD)"
    },
    "seller_payout": {
      "type": "number",
      "description": "Amount owed to seller after platform fee (USD)"
    },
    "quantity": {
      "type": "number"
    },
    "payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID"
    },
    "payment_captured": {
      "type": "boolean",
      "default": false
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "pending_transfer",
        "completed",
        "expired",
        "disputed"
      ],
      "default": "pending_transfer"
    },
    "buyer_confirmed": {
      "type": "boolean",
      "default": false
    },
    "seller_confirmed": {
      "type": "boolean",
      "default": false
    },
    "seller_confirmed_at": {
      "type": "string",
      "description": "ISO timestamp when seller confirmed transfer \u2014 used for buyer reminder cadence"
    },
    "transfer_notes": {
      "type": "string"
    },
    "transfer_proof_url": {
      "type": "string"
    },
    "dispute_reason": {
      "type": "string"
    },
    "buyer_lat": {
      "type": "number"
    },
    "buyer_lng": {
      "type": "number"
    },
    "location_verified": {
      "type": "boolean",
      "default": false
    },
    "reminder_flags": {
      "type": "object",
      "description": "Tracks which reminder notifications have been sent to prevent duplicates",
      "properties": {
        "seller_r1": {
          "type": "boolean"
        },
        "seller_r2": {
          "type": "boolean"
        },
        "buyer_r1": {
          "type": "boolean"
        },
        "buyer_r2": {
          "type": "boolean"
        }
      }
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "awaiting_pg_transfer",
        "transfer_in_progress",
        "fulfilled",
        "buyer_confirmed",
        "issue_reported"
      ],
      "description": "Tracks PG fulfillment state for instant listing purchases"
    },
    "fulfillment_proof_url": {
      "type": "string",
      "description": "Admin-uploaded proof of ticket transfer to buyer"
    },
    "fulfillment_notes": {
      "type": "string",
      "description": "Admin notes on fulfillment action"
    },
    "fulfillment_started_at": {
      "type": "string",
      "description": "ISO timestamp when PG marked transfer started"
    },
    "fulfillment_completed_at": {
      "type": "string",
      "description": "ISO timestamp when PG marked transfer complete"
    }
  },
  "required": [
    "listing_id",
    "event_id",
    "amount"
  ]
}