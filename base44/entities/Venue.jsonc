{
  "name": "Venue",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "tm_venue_id": {
      "type": "string",
      "description": "Ticketmaster's stable venue identifier \u2014 the permanent relationship key."
    },
    "name": {
      "type": "string",
      "description": "Canonical venue display name"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "e.g. AZ"
    },
    "country_code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code from the provider."
    },
    "address_line1": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "timezone": {
      "type": "string",
      "description": "IANA venue timezone used for local event display."
    },
    "hero_image": {
      "type": "string",
      "description": "Optional PG-hosted venue hero image URL. When present and an event has no Ticketmaster artwork, this is used as the event hero."
    },
    "identity_type": {
      "type": "string",
      "enum": [
        "sports",
        "concert",
        "theater",
        "comedy",
        "festival",
        "racing",
        "convention",
        "other"
      ],
      "default": "other",
      "description": "Primary identity of the venue. Inferred from the first event's category on creation; admin-owned thereafter."
    }
  },
  "required": [
    "tm_venue_id",
    "name"
  ]
}
