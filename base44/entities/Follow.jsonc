{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_email": {
      "type": "string",
      "description": "Email of the user who is following"
    },
    "following_email": {
      "type": "string",
      "description": "Email of the user being followed"
    },
    "following_name": {
      "type": "string",
      "description": "Display name of the user being followed (cached)"
    },
    "following_avatar_url": {
      "type": "string",
      "description": "Avatar URL of the user being followed (cached)"
    }
  },
  "required": [
    "follower_email",
    "following_email"
  ]
}