{
  "name": "ListingPrivate",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "listing_id": {
      "type": "string",
      "description": "FK to Listing \u2014 primary key. One sidecar per Listing."
    },
    "event_id": {
      "type": "string"
    },
    "seller_email": {
      "type": "string",
      "description": "Exact private seller identity."
    },
    "section": {
      "type": "string",
      "description": "Exact private seat location."
    },
    "row": {
      "type": "string"
    },
    "seats": {
      "type": "string",
      "description": "Exact private seat numbers."
    },
    "quantity": {
      "type": "number"
    },
    "proof_url": {
      "type": "string",
      "description": "Legacy public proof URL \u2014 copied for traceability only; NOT trusted as private. Re-upload required via ProofAsset."
    },
    "proof_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ]
    },
    "proof_rejection_reason": {
      "type": "string"
    },
    "current_proof_asset_id": {
      "type": "string",
      "description": "FK to the current authoritative ProofAsset for this listing's proof. Only this asset may be reviewed/approved/rejected. Re-uploads supersede the previous asset and reset this field."
    },
    "ticket_file_url": {
      "type": "string"
    },
    "reservation_token": {
      "type": "string",
      "description": "Private checkout reservation token."
    },
    "reservation_expires_at": {
      "type": "string"
    },
    "reserved_by_email": {
      "type": "string",
      "description": "Private buyer holding the reservation."
    },
    "reservation_revision": {
      "type": "string",
      "description": "Monotonic revision generated by the authority on each transition. Private \u2014 never projected to Listing."
    },
    "transfer_verification_proof_url": {
      "type": "string",
      "description": "Legacy public transfer-verification URL \u2014 requires private re-upload."
    },
    "transfer_verified_by": {
      "type": "string"
    },
    "transfer_verified_notes": {
      "type": "string"
    },
    "pg_transfer_proof_url": {
      "type": "string"
    },
    "pg_transfer_notes": {
      "type": "string"
    },
    "pg_fulfilled_at": {
      "type": "string"
    },
    "pg_fulfilled_by": {
      "type": "string"
    },
    "seller_ownership_confirmed": {
      "type": "boolean",
      "default": false
    },
    "limited_transfer_authorization": {
      "type": "boolean",
      "default": false
    },
    "ticket_custody_status": {
      "type": "string",
      "enum": [
        "not_received",
        "pending",
        "received",
        "delivered_to_buyer",
        "returned_to_seller",
        "failed",
        "expired"
      ]
    },
    "custody_received_at": {
      "type": "string"
    },
    "buyer_delivered_at": {
      "type": "string"
    },
    "returned_to_seller_at": {
      "type": "string"
    },
    "transfer_failure_reason": {
      "type": "string"
    },
    "seller_release_deadline": {
      "type": "string"
    },
    "custody_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_pg_verification",
        "verified",
        "rejected"
      ]
    },
    "seat_inventory_id": {
      "type": "string",
      "description": "FK to SeatInventory."
    },
    "checkout_quarantined": {
      "type": "boolean",
      "default": false,
      "description": "True when this listing was quarantined by a failed checkout."
    },
    "checkout_quarantine_reason": {
      "type": "string",
      "description": "Reason for the checkout quarantine."
    },
    "checkout_quarantined_at": {
      "type": "string",
      "description": "ISO timestamp when the quarantine was applied."
    },
    "checkout_quarantine_pi_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID that triggered the quarantine."
    },
    "quarantined_reservation_token": {
      "type": "string",
      "description": "IMMUTABLE durable snapshot of reservation_token at first quarantine time. Recovery requires exact match against current LP value. Never overwritten by a repeated quarantine."
    },
    "quarantined_buyer": {
      "type": "string",
      "description": "IMMUTABLE durable snapshot of reserved_by_email at first quarantine time."
    },
    "quarantined_expiration": {
      "type": "string",
      "description": "IMMUTABLE durable snapshot of reservation_expires_at at first quarantine time."
    },
    "quarantined_purchase_id": {
      "type": "string",
      "description": "IMMUTABLE durable snapshot of purchase_id at first quarantine time."
    },
    "quarantine_generation": {
      "type": "number",
      "description": "Set once at first quarantine. NEVER mutated by repeated quarantines \u2014 the original generation is preserved across divergence and same-state repeats. Recovery captures this at start and re-checks before every write. A newer generation must never be cleared by an older recovery."
    },
    "recovery_not_before": {
      "type": "string",
      "description": "ISO timestamp before which recovery must not run. Enforces a drain period so in-flight reserve/checkout requests finish."
    },
    "recovery_blocked": {
      "type": "boolean",
      "default": false,
      "description": "Durable marker prohibiting automatic recovery. Set when a repeated quarantine detects that current reservation state differs from the original snapshot, or when generation/PI/purchase mismatch is detected during recovery, or when a token-bearing quarantine cannot be auto-cleared. Requires manual resolution."
    },
    "recovery_blocked_reason": {
      "type": "string",
      "description": "Reason the listing was blocked from automatic recovery."
    },
    "recovery_blocked_at": {
      "type": "string",
      "description": "ISO timestamp when recovery was blocked."
    },
    "seller_cancel_requested_at": {
      "type": "string",
      "description": "Durable seller cancellation intent. Written BEFORE public Listing status changes. Recovery checks this before and after every write. Permanent for cancelled listings \u2014 never cleared by resume."
    },
    "seller_pause_requested_at": {
      "type": "string",
      "description": "Durable seller pause intent. Written BEFORE public Listing status changes. Cleared only after Listing and SeatInventory resume writes succeed and are verified."
    },
    "is_demo_listing": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "description": "May contain [TEST]/[DEMO] markers."
    },
    "migration_version": {
      "type": "number",
      "description": "Migration schema version that produced this sidecar."
    },
    "migrated_at": {
      "type": "string",
      "description": "ISO timestamp when the sidecar was created."
    },
    "reservation_version": {
      "type": "number",
      "description": "Numeric monotonic version for single-authority CAS. Incremented on every authoritative transition. Used as the CAS expected-version predicate. Existing records without this field require MIGRATION_REQUIRED initialization."
    },
    "reservation_lifecycle_state": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "frozen",
        "sold",
        "cancelled",
        "expired"
      ],
      "description": "Authoritative lifecycle state in the single-authority model."
    },
    "last_operation_id": {
      "type": "string",
      "description": "Unique ID of the last operation that transitioned this reservation. Used for idempotent replay detection."
    },
    "last_operation_type": {
      "type": "string",
      "description": "Type of the last operation (reserve, release, freeze, finalize, cancel, expire, initialize)."
    },
    "last_operation_payload_hash": {
      "type": "string",
      "description": "SHA-256 hash of the complete semantic operation envelope (operation_type, requested_state, payload, pending_effects). Required to match for idempotent replay."
    },
    "last_operation_result_json": {
      "type": "string",
      "description": "JSON string of the last operation's result. Returned on idempotent replay. Schema type: string (not object)."
    },
    "last_operation_at": {
      "type": "string",
      "description": "ISO timestamp of the last operation."
    },
    "pending_effects_json": {
      "type": "string",
      "description": "JSON string of pending side effects that must be delivered after the authoritative transition commits. Undelivered effects block the next transition (PENDING_EFFECTS_BLOCKED). Schema type: string (not object)."
    }
  },
  "required": [
    "listing_id"
  ]
}