{
  "name": "FlashDrop",
  "type": "object",
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "donor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "donor_email": {
      "type": "string"
    },
    "donor_name": {
      "type": "string"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "section": {
      "type": "string"
    },
    "row": {
      "type": "string"
    },
    "seats": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "donor_message": {
      "type": "string"
    },
    "drop_type": {
      "type": "string",
      "enum": [
        "immediate",
        "scheduled"
      ],
      "default": "immediate"
    },
    "scheduled_label": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "closed",
        "winner_selected",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "entry_opens_at": {
      "type": "string"
    },
    "entry_closes_at": {
      "type": "string"
    },
    "entry_window_seconds": {
      "type": "number",
      "default": 60
    },
    "winner_email": {
      "type": "string"
    },
    "winner_name": {
      "type": "string"
    },
    "winner_selected_at": {
      "type": "string"
    },
    "winner_selection_locked_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 set atomically when the first close_and_pick call begins processing. Guards against race conditions."
    },
    "winner_selection_request_id": {
      "type": "string",
      "description": "Unique ID of the first close_and_pick request. Used for idempotency."
    },
    "selection_completed_at": {
      "type": "string",
      "description": "ISO timestamp when winner selection fully completed."
    },
    "entry_count": {
      "type": "number",
      "default": 0
    },
    "source_purchase_id": {
      "type": "string"
    },
    "source_donation_id": {
      "type": "string"
    },
    "ownership_verified": {
      "type": "boolean",
      "default": false,
      "description": "True if donor's ownership of this seat has been verified"
    },
    "ownership_verification_method": {
      "type": "string",
      "enum": [
        "verified_listing",
        "verified_ticket_file",
        "ownership_proof_upload",
        "transfer_capability",
        "admin_verified"
      ],
      "description": "How ownership was verified"
    },
    "ownership_verified_at": {
      "type": "string"
    },
    "ownership_listing_id": {
      "type": "string",
      "description": "FK to Listing \u2014 if verified via existing listing"
    },
    "ownership_delivery_method": {
      "type": "string",
      "enum": [
        "ticket_transfer",
        "account_transfer",
        "seller_contact",
        "manual_release",
        "future_custody"
      ],
      "description": "How winner will receive the seat"
    },
    "trust_score": {
      "type": "number",
      "description": "0\u2013100 trust score. >= 80 = Verified Flash Drop badge.",
      "default": 0
    },
    "trust_breakdown": {
      "type": "object",
      "description": "Components of the trust score",
      "properties": {
        "ownership_verified": {
          "type": "number"
        },
        "transfer_confirmed": {
          "type": "number"
        },
        "verified_seller": {
          "type": "number"
        },
        "prior_transfers": {
          "type": "number"
        }
      }
    },
    "abuse_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Any anti-abuse flags on this drop"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "views": {
          "type": "number"
        },
        "entries": {
          "type": "number"
        },
        "loser_upgrade_clicks": {
          "type": "number"
        },
        "loser_purchases": {
          "type": "number"
        },
        "notification_sent": {
          "type": "number"
        },
        "notification_opened": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "event_id",
    "donor_email",
    "section"
  ]
}