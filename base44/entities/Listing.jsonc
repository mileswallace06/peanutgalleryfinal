{
  "name": "Listing",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "FK to Event"
    },
    "seller_email": {
      "type": "string",
      "description": "Set to created_by on creation"
    },
    "section": {
      "type": "string",
      "description": "e.g. 118"
    },
    "row": {
      "type": "string",
      "description": "e.g. G"
    },
    "seats": {
      "type": "string",
      "description": "Comma-separated seat numbers"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "floor",
        "lower",
        "mid",
        "upper"
      ]
    },
    "asking_price": {
      "type": "number",
      "description": "Per seat, USD"
    },
    "original_price": {
      "type": "number",
      "description": "Face value for savings display"
    },
    "transfer_method": {
      "type": "string",
      "enum": [
        "platform_transfer",
        "email_transfer",
        "in_person"
      ]
    },
    "proof_url": {
      "type": "string"
    },
    "proof_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "pending_review"
    },
    "proof_rejection_reason": {
      "type": "string"
    },
    "ticket_file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_transfer",
        "sold",
        "cancelled",
        "expired",
        "pending_verification"
      ],
      "default": "active"
    },
    "listing_mode": {
      "type": "string",
      "enum": [
        "standard",
        "instant"
      ],
      "default": "standard",
      "description": "standard = seller transfers after purchase; instant = PG holds ticket before listing goes live"
    },
    "custody_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_pg_verification",
        "verified",
        "rejected"
      ],
      "default": "none",
      "description": "Tracks whether PG has verified custody of the ticket for instant listings"
    },
    "pg_transfer_proof_url": {
      "type": "string",
      "description": "Proof seller transferred ticket to PG (instant listings)"
    },
    "pg_transfer_notes": {
      "type": "string",
      "description": "Seller notes on the PG transfer"
    },
    "pg_fulfilled_at": {
      "type": "string",
      "description": "ISO timestamp when PG fulfilled the transfer to buyer"
    },
    "pg_fulfilled_by": {
      "type": "string",
      "description": "Admin email who marked fulfillment"
    },
    "reservation_token": {
      "type": "string",
      "description": "UUID set when a buyer begins checkout \u2014 prevents double-sell"
    },
    "reservation_expires_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 reservation auto-expires after 10 minutes"
    },
    "reserved_by_email": {
      "type": "string",
      "description": "Email of buyer who holds the current reservation"
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "transfer_confirmed",
        "transfer_unconfirmed",
        "transfer_disabled",
        "transfer_expired"
      ],
      "default": "transfer_unconfirmed",
      "description": "Listing-level transfer availability status \u2014 source of truth for purchase eligibility"
    },
    "transfer_confidence_score": {
      "type": "number",
      "description": "0-100 confidence that this specific ticket can still be transferred"
    },
    "last_transfer_verification": {
      "type": "string",
      "description": "ISO timestamp of the most recent transfer verification"
    },
    "transfer_verification_method": {
      "type": "string",
      "enum": [
        "seller_attestation",
        "screenshot_verified",
        "admin_verified",
        "buyer_confirmed",
        "community_verified"
      ],
      "description": "Method used to verify transfer availability"
    },
    "transfer_verification_proof_url": {
      "type": "string",
      "description": "Screenshot or proof of transfer availability"
    },
    "transfer_verified_by": {
      "type": "string",
      "description": "Email of user/admin who verified"
    },
    "transfer_verified_notes": {
      "type": "string",
      "description": "Notes on verification decision"
    },
    "transfer_platform": {
      "type": "string",
      "enum": [
        "ticketmaster",
        "seatgeek",
        "axs",
        "stubhub",
        "apple_wallet",
        "other"
      ],
      "description": "Ticketing platform seller confirmed transfer is available on"
    }
  },
  "required": [
    "event_id",
    "section",
    "row",
    "asking_price"
  ]
}