{
  "name": "Listing",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "FK to Event"
    },
    "seller_email": {
      "type": "string",
      "description": "Set to created_by on creation"
    },
    "section": {
      "type": "string",
      "description": "e.g. 118"
    },
    "row": {
      "type": "string",
      "description": "e.g. G"
    },
    "seats": {
      "type": "string",
      "description": "Comma-separated seat numbers"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "floor",
        "lower",
        "mid",
        "upper"
      ]
    },
    "asking_price": {
      "type": "number",
      "description": "Per seat, USD"
    },
    "original_price": {
      "type": "number",
      "description": "Face value for savings display"
    },
    "transfer_method": {
      "type": "string",
      "enum": [
        "platform_transfer",
        "email_transfer",
        "in_person"
      ]
    },
    "proof_url": {
      "type": "string"
    },
    "proof_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "pending_review"
    },
    "proof_rejection_reason": {
      "type": "string"
    },
    "ticket_file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_transfer",
        "sold",
        "cancelled",
        "expired",
        "pending_verification",
        "hidden",
        "pending_payout_setup"
      ],
      "default": "active",
      "description": "pending_payout_setup = draft saved before seller completed Stripe Connect onboarding."
    },
    "hidden_reason": {
      "type": "string",
      "enum": [
        "transfer_disabled",
        "admin_disabled",
        "expired_verification",
        "sold",
        "other",
        "checkout_quarantine"
      ],
      "description": "Why this listing is hidden from the marketplace"
    },
    "listing_mode": {
      "type": "string",
      "enum": [
        "standard",
        "instant"
      ],
      "default": "standard"
    },
    "listing_transfer_mode": {
      "type": "string",
      "enum": [
        "standard",
        "instant_transfer_ready"
      ],
      "default": "standard",
      "description": "standard = seller transfers after sale. instant_transfer_ready = seller has authorized PG as limited transfer agent and submitted ticket for delivery custody."
    },
    "seller_ownership_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Seller confirmed they own or control this ticket at time of listing."
    },
    "limited_transfer_authorization": {
      "type": "boolean",
      "default": false,
      "description": "Seller authorized PG to act as limited transfer agent solely for buyer delivery."
    },
    "ticket_custody_status": {
      "type": "string",
      "enum": [
        "not_received",
        "pending",
        "received",
        "delivered_to_buyer",
        "returned_to_seller",
        "failed",
        "expired"
      ],
      "default": "not_received",
      "description": "Tracks the state of the ticket through PG's temporary delivery custody."
    },
    "custody_received_at": {
      "type": "string",
      "description": "ISO timestamp when PG confirmed receipt of the ticket transfer."
    },
    "buyer_delivered_at": {
      "type": "string",
      "description": "ISO timestamp when ticket was transferred to buyer."
    },
    "returned_to_seller_at": {
      "type": "string",
      "description": "ISO timestamp when ticket was returned or released to seller."
    },
    "transfer_failure_reason": {
      "type": "string",
      "description": "Human-readable reason if delivery to buyer failed."
    },
    "seller_release_deadline": {
      "type": "string",
      "description": "ISO timestamp by which seller must submit ticket for ITR custody."
    },
    "event_start_time": {
      "type": "string",
      "description": "Cached ISO timestamp of event start \u2014 used to enforce ITR expiry logic."
    },
    "custody_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_pg_verification",
        "verified",
        "rejected"
      ],
      "default": "none"
    },
    "pg_transfer_proof_url": {
      "type": "string"
    },
    "pg_transfer_notes": {
      "type": "string"
    },
    "pg_fulfilled_at": {
      "type": "string"
    },
    "pg_fulfilled_by": {
      "type": "string"
    },
    "reservation_token": {
      "type": "string"
    },
    "reservation_expires_at": {
      "type": "string"
    },
    "reserved_by_email": {
      "type": "string"
    },
    "reservation_revision": {
      "type": "string",
      "description": "Monotonic revision that changes on every reservation-tuple mutation (token/buyer/expiration write). Used by capture freeze to detect post-freeze reservation mutation even if individual fields are re-set to the same values."
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "transfer_confirmed",
        "transfer_unconfirmed",
        "transfer_disabled",
        "transfer_expired"
      ],
      "default": "transfer_unconfirmed"
    },
    "transfer_confidence_score": {
      "type": "number"
    },
    "last_transfer_verification": {
      "type": "string"
    },
    "transfer_verification_method": {
      "type": "string",
      "enum": [
        "seller_attestation",
        "screenshot_verified",
        "admin_verified",
        "buyer_confirmed",
        "community_verified"
      ]
    },
    "transfer_verification_proof_url": {
      "type": "string"
    },
    "transfer_verified_by": {
      "type": "string"
    },
    "transfer_verified_notes": {
      "type": "string"
    },
    "transfer_platform": {
      "type": "string",
      "enum": [
        "ticketmaster",
        "seatgeek",
        "axs",
        "stubhub",
        "apple_wallet",
        "other"
      ]
    },
    "verification_warning_sent_at": {
      "type": "string"
    },
    "verification_expired_sent_at": {
      "type": "string"
    },
    "seat_inventory_id": {
      "type": "string",
      "description": "FK to SeatInventory"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "resale_ticket",
        "venue_ticket",
        "live_upgrade",
        "venue_upgrade"
      ],
      "default": "resale_ticket"
    },
    "inventory_source": {
      "type": "string",
      "enum": [
        "fan",
        "broker",
        "venue_partner",
        "pg_inventory",
        "pg_demo",
        "other"
      ],
      "default": "fan"
    },
    "requires_existing_ticket": {
      "type": "boolean",
      "default": false
    },
    "requires_location": {
      "type": "boolean",
      "default": false
    },
    "location_requirement": {
      "type": "string",
      "enum": [
        "none",
        "venue_proximity",
        "inside_venue",
        "city_only"
      ],
      "default": "none"
    },
    "upgrade_window_opens_at": {
      "type": "string"
    },
    "upgrade_window_closes_at": {
      "type": "string"
    },
    "upgrade_instructions": {
      "type": "string"
    },
    "is_demo_listing": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "section",
    "row",
    "asking_price"
  ]
}