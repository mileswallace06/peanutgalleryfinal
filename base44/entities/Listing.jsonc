{
  "name": "Listing",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "FK to Event"
    },
    "seller_email": {
      "type": "string",
      "description": "Set to created_by on creation"
    },
    "section": {
      "type": "string",
      "description": "e.g. 118"
    },
    "row": {
      "type": "string",
      "description": "e.g. G"
    },
    "seats": {
      "type": "string",
      "description": "Comma-separated seat numbers"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "floor",
        "lower",
        "mid",
        "upper"
      ]
    },
    "asking_price": {
      "type": "number",
      "description": "Per seat, USD"
    },
    "original_price": {
      "type": "number",
      "description": "Face value for savings display"
    },
    "transfer_method": {
      "type": "string",
      "enum": [
        "platform_transfer",
        "email_transfer",
        "in_person"
      ]
    },
    "proof_url": {
      "type": "string"
    },
    "proof_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "pending_review"
    },
    "proof_rejection_reason": {
      "type": "string"
    },
    "ticket_file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_transfer",
        "sold",
        "cancelled",
        "expired",
        "pending_verification",
        "hidden",
        "pending_payout_setup"
      ],
      "default": "active",
      "description": "pending_payout_setup = draft saved before seller completed Stripe Connect onboarding. Never shown to buyers."
    },
    "hidden_reason": {
      "type": "string",
      "enum": [
        "transfer_disabled",
        "admin_disabled",
        "expired_verification",
        "sold",
        "other"
      ],
      "description": "Why this listing is hidden from the marketplace"
    },
    "listing_mode": {
      "type": "string",
      "enum": [
        "standard",
        "instant"
      ],
      "default": "standard"
    },
    "custody_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_pg_verification",
        "verified",
        "rejected"
      ],
      "default": "none"
    },
    "pg_transfer_proof_url": {
      "type": "string"
    },
    "pg_transfer_notes": {
      "type": "string"
    },
    "pg_fulfilled_at": {
      "type": "string"
    },
    "pg_fulfilled_by": {
      "type": "string"
    },
    "reservation_token": {
      "type": "string"
    },
    "reservation_expires_at": {
      "type": "string"
    },
    "reserved_by_email": {
      "type": "string"
    },
    "transfer_status": {
      "type": "string",
      "enum": [
        "transfer_confirmed",
        "transfer_unconfirmed",
        "transfer_disabled",
        "transfer_expired"
      ],
      "default": "transfer_unconfirmed"
    },
    "transfer_confidence_score": {
      "type": "number"
    },
    "last_transfer_verification": {
      "type": "string"
    },
    "transfer_verification_method": {
      "type": "string",
      "enum": [
        "seller_attestation",
        "screenshot_verified",
        "admin_verified",
        "buyer_confirmed",
        "community_verified"
      ]
    },
    "transfer_verification_proof_url": {
      "type": "string"
    },
    "transfer_verified_by": {
      "type": "string"
    },
    "transfer_verified_notes": {
      "type": "string"
    },
    "transfer_platform": {
      "type": "string",
      "enum": [
        "ticketmaster",
        "seatgeek",
        "axs",
        "stubhub",
        "apple_wallet",
        "other"
      ]
    },
    "verification_warning_sent_at": {
      "type": "string",
      "description": "When the 45-min expiration warning was sent"
    },
    "verification_expired_sent_at": {
      "type": "string",
      "description": "When the expiration notification was sent"
    },
    "seat_inventory_id": {
      "type": "string",
      "description": "FK to SeatInventory \u2014 canonical ownership record for this seat"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "resale_ticket",
        "seat_upgrade",
        "parking_pass",
        "experience_add_on",
        "other"
      ],
      "default": "resale_ticket",
      "description": "What kind of listing this is. Existing listings default to resale_ticket."
    },
    "inventory_source": {
      "type": "string",
      "enum": [
        "fan",
        "broker",
        "venue_partner",
        "pg_inventory",
        "other"
      ],
      "default": "fan",
      "description": "Where the inventory originates. Existing listings default to fan."
    },
    "requires_existing_ticket": {
      "type": "boolean",
      "default": false,
      "description": "True if the buyer must already have a ticket to this event to purchase (e.g. seat upgrades)"
    },
    "requires_location": {
      "type": "boolean",
      "default": false,
      "description": "True if purchase requires buyer to be at or near the venue"
    },
    "location_requirement": {
      "type": "string",
      "enum": [
        "none",
        "venue_proximity",
        "inside_venue",
        "city_only"
      ],
      "default": "none",
      "description": "How strict the location gate is for this listing"
    },
    "upgrade_window_opens_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 when this listing becomes purchasable (for time-gated upgrades)"
    },
    "upgrade_window_closes_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 when this listing stops being purchasable"
    },
    "upgrade_instructions": {
      "type": "string",
      "description": "Free-text instructions shown to buyer after purchase (e.g. 'Go to Gate B and show this screen')"
    },
    "is_demo_listing": {
      "type": "boolean",
      "default": false,
      "description": "True for demo/test listings. Replaces the legacy [DEMO] notes prefix pattern."
    }
  },
  "required": [
    "event_id",
    "section",
    "row",
    "asking_price"
  ]
}