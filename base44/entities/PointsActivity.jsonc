{
  "name": "PointsActivity",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who earned/lost points"
    },
    "action": {
      "type": "string",
      "enum": [
        "profile_completed",
        "stripe_connected",
        "first_purchase",
        "first_sale",
        "first_instant_listing",
        "purchase",
        "sale_completed",
        "instant_listing_verified",
        "instant_listing_sold",
        "live_upgrade_purchase",
        "live_upgrade_sale",
        "seller_transfer_15min",
        "seller_transfer_1hr",
        "buyer_confirm_15min",
        "buyer_confirm_1hr",
        "instant_fulfillment_clean",
        "feedback_left",
        "fan_zone_post",
        "beta_bug_report",
        "critical_bug_report",
        "referral_signup",
        "referral_first_transaction",
        "referral_verified_seller",
        "failed_transfer",
        "confirmed_fraud",
        "seller_dispute",
        "repeated_cancellation",
        "abusive_behavior",
        "achievement_unlock",
        "trust_bonus"
      ],
      "description": "Type of action that triggered this points event"
    },
    "points": {
      "type": "number",
      "description": "Points awarded (positive) or deducted (negative)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the activity"
    },
    "reference_id": {
      "type": "string",
      "description": "ID of related entity (purchase_id, listing_id, etc.)"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "purchase",
        "listing",
        "event",
        "referral",
        "profile",
        "feedback",
        "post",
        "bug_report"
      ],
      "description": "Type of the related entity"
    },
    "source": {
      "type": "string",
      "description": "System component that triggered this event (e.g. capturePayment, awardPoints)"
    },
    "is_reversal": {
      "type": "boolean",
      "default": false,
      "description": "True if this entry reverses a prior award"
    },
    "metadata": {
      "type": "object",
      "description": "Optional extra context (e.g. transfer time, dispute reason)"
    }
  },
  "required": [
    "user_email",
    "action",
    "points"
  ]
}