{
  "name": "PointsActivity",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "profile_completed",
        "stripe_connected",
        "first_purchase",
        "first_sale",
        "first_instant_listing",
        "purchase",
        "sale_completed",
        "instant_listing_verified",
        "instant_listing_sold",
        "live_upgrade_purchase",
        "live_upgrade_sale",
        "seller_transfer_15min",
        "seller_transfer_1hr",
        "buyer_confirm_15min",
        "buyer_confirm_1hr",
        "instant_fulfillment_clean",
        "feedback_left",
        "fan_zone_post",
        "beta_bug_report",
        "critical_bug_report",
        "referral_signup",
        "referral_first_transaction",
        "referral_verified_seller",
        "seat_donation_created",
        "donation_accepted",
        "live_event_donation",
        "donation_received",
        "failed_transfer",
        "confirmed_fraud",
        "seller_dispute",
        "repeated_cancellation",
        "abusive_behavior",
        "achievement_unlock",
        "trust_bonus"
      ]
    },
    "points": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "purchase",
        "listing",
        "event",
        "referral",
        "profile",
        "feedback",
        "post",
        "bug_report",
        "donation"
      ]
    },
    "source": {
      "type": "string"
    },
    "is_reversal": {
      "type": "boolean",
      "default": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "user_email",
    "action",
    "points"
  ]
}