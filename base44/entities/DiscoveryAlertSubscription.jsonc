{
  "name": "DiscoveryAlertSubscription",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "preference_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "user_email",
    "event_id",
    "enabled"
  ]
}
