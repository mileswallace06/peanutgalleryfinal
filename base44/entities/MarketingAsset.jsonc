{
  "name": "MarketingAsset",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name for this asset in history/templates"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "social_graphic",
        "carousel",
        "mockup"
      ],
      "default": "social_graphic"
    },
    "graphic_type": {
      "type": "string",
      "enum": [
        "industry_truth",
        "feature_spotlight",
        "founder_story",
        "announcement",
        "statistic",
        "quote",
        "coming_soon",
        "launch",
        "milestone",
        "problem",
        "partnership",
        "waitlist",
        "update",
        "venue_spotlight",
        "ticket_tip",
        "fan_story",
        "comparison",
        "question",
        "iphone",
        "laptop",
        "billboard",
        "jumbotron",
        "floating_card",
        "website_hero",
        "instagram_post",
        "presentation"
      ],
      "default": "industry_truth"
    },
    "canvas_preset": {
      "type": "string",
      "enum": [
        "1080x1350",
        "1080x1080",
        "1920x1080",
        "story",
        "linkedin",
        "x",
        "facebook"
      ],
      "default": "1080x1350"
    },
    "content": {
      "type": "object",
      "description": "The user-authored content payload rendered into the graphic. Includes creative direction IDs, creative intent (semantic, internal), locks, and version history with natural-language direction descriptions and explanations.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "subheadline": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "stat_number": {
          "type": "string"
        },
        "stat_label": {
          "type": "string"
        },
        "stat_explanation": {
          "type": "string"
        },
        "image_url": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "quote_text": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "strategy_id": {
          "type": "string",
          "description": "Creative Strategy ID (Decision 1)"
        },
        "concept_id": {
          "type": "string",
          "description": "Creative Concept ID (Decision 2)"
        },
        "execution_style_id": {
          "type": "string",
          "description": "Execution Style ID (Decision 3)"
        },
        "creative_intent": {
          "type": "object",
          "description": "Semantic creative direction from the AI Creative Director. Internal reasoning layer \u2014 never exposed to users directly. The Intent Translator converts this into rendering modifications at render time.",
          "additionalProperties": true
        },
        "creative_locks": {
          "type": "object",
          "description": "Lockable design categories. When locked, AI edits must never modify that category.",
          "properties": {
            "layout": {
              "type": "boolean"
            },
            "typography": {
              "type": "boolean"
            },
            "background": {
              "type": "boolean"
            },
            "colors": {
              "type": "boolean"
            },
            "decorative": {
              "type": "boolean"
            },
            "imagery": {
              "type": "boolean"
            },
            "logo": {
              "type": "boolean"
            },
            "cta": {
              "type": "boolean"
            }
          }
        },
        "creative_versions": {
          "type": "array",
          "description": "Snapshots of creative state after each AI edit. Each version includes a natural-language direction description and a detailed explanation of what changed. Supports restore, favorite, and naming.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              },
              "instruction": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "explanation": {
                "type": "string",
                "description": "Detailed natural-language explanation of what the AI changed and why"
              },
              "direction_description": {
                "type": "string",
                "description": "Natural-language description of the overall creative direction at this version"
              },
              "name": {
                "type": "string"
              },
              "is_favorite": {
                "type": "boolean"
              },
              "snapshot": {
                "type": "object",
                "properties": {
                  "creative_intent": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "creative_locks": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "concept_id": {
                    "type": "string"
                  },
                  "execution_style_id": {
                    "type": "string"
                  },
                  "strategy_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "graphic_type": {
                "type": "string"
              },
              "content": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "dark_purple",
        "dark_green",
        "dark_cyan",
        "dark_pink"
      ],
      "default": "dark"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Preview image URL generated on save"
    },
    "is_template": {
      "type": "boolean",
      "default": false
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "asset_type",
    "graphic_type",
    "canvas_preset"
  ]
}