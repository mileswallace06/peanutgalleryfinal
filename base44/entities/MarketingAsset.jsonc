{
  "name": "MarketingAsset",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name for this asset in history/templates"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "social_graphic",
        "carousel",
        "announcement",
        "quote",
        "statistic",
        "feature_spotlight",
        "founder_story",
        "mockup"
      ],
      "default": "social_graphic"
    },
    "graphic_type": {
      "type": "string",
      "enum": [
        "industry_truth",
        "feature_spotlight",
        "founder_story",
        "announcement",
        "statistic",
        "quote",
        "coming_soon",
        "launch",
        "milestone",
        "problem",
        "partnership",
        "waitlist",
        "update",
        "venue_spotlight",
        "ticket_tip",
        "fan_story",
        "comparison",
        "question"
      ],
      "default": "industry_truth"
    },
    "canvas_preset": {
      "type": "string",
      "enum": [
        "1080x1350",
        "1080x1080",
        "1920x1080",
        "story",
        "linkedin",
        "x",
        "facebook"
      ],
      "default": "1080x1350"
    },
    "content": {
      "type": "object",
      "description": "The user-authored content payload rendered into the graphic.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "subheadline": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "stat_number": {
          "type": "string"
        },
        "stat_label": {
          "type": "string"
        },
        "stat_explanation": {
          "type": "string"
        },
        "image_url": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "quote_text": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "dark_purple",
        "dark_green",
        "dark_cyan",
        "dark_pink"
      ],
      "default": "dark"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Preview image URL generated on save"
    },
    "is_template": {
      "type": "boolean",
      "default": false
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "asset_type",
    "graphic_type",
    "canvas_preset"
  ]
}