{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "strike_count": {
      "type": "number",
      "default": 0
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect Express account ID (acct_xxx) assigned after onboarding"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once Stripe reports charges_enabled on the connected account"
    }
  },
  "required": []
}