{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "strike_count": {
      "type": "number",
      "default": 0
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "persona_name": {
      "type": "string"
    },
    "persona_style": {
      "type": "string"
    },
    "verified_fan": {
      "type": "boolean",
      "default": false
    },
    "peanut_points": {
      "type": "number",
      "default": 0
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by": {
      "type": "string"
    },
    "seller_transfer_reliability": {
      "type": "number",
      "description": "0-100 seller reliability score. Updated after each transfer outcome.",
      "default": 70
    },
    "transfer_success_count": {
      "type": "number",
      "default": 0,
      "description": "Lifetime successful transfers"
    },
    "transfer_fail_count": {
      "type": "number",
      "default": 0,
      "description": "Lifetime failed/disputed transfers"
    },
    "transfer_expired_count": {
      "type": "number",
      "default": 0,
      "description": "Times verification expired before a sale"
    },
    "transfer_false_claim_count": {
      "type": "number",
      "default": 0,
      "description": "Times seller claimed transfer available but it wasn't"
    }
  }
}