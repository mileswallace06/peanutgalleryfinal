{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "strikes": {
      "type": "number",
      "default": 0
    },
    "notification_new_message": {
      "type": "boolean",
      "default": true
    },
    "notification_sale": {
      "type": "boolean",
      "default": true
    },
    "notification_price_drop": {
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}