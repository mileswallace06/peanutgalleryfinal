{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "favorite_team": {
      "type": "string"
    },
    "peanut_points": {
      "type": "number",
      "default": 0,
      "description": "Current spendable/displayed balance"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "All-time accumulated \u2014 used for rank calculation, never decrements"
    },
    "peanut_level": {
      "type": "number",
      "default": 1
    },
    "peanut_rank": {
      "type": "string",
      "default": "Rookie Fan"
    },
    "trust_score": {
      "type": "number",
      "default": 50,
      "description": "0\u2013100 marketplace reliability score"
    },
    "trust_badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by": {
      "type": "string",
      "description": "Email of referrer"
    },
    "total_purchases": {
      "type": "number",
      "default": 0
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "total_instant_listings": {
      "type": "number",
      "default": 0
    },
    "total_live_upgrades": {
      "type": "number",
      "default": 0
    },
    "total_fast_transfers": {
      "type": "number",
      "default": 0,
      "description": "Seller transfers completed within 1 hour"
    },
    "total_disputes": {
      "type": "number",
      "default": 0
    },
    "total_failed_transfers": {
      "type": "number",
      "default": 0
    },
    "total_cancelled_sales": {
      "type": "number",
      "default": 0
    },
    "confirmed_fraud_count": {
      "type": "number",
      "default": 0
    },
    "false_dispute_count": {
      "type": "number",
      "default": 0
    },
    "seller_streak": {
      "type": "number",
      "default": 0,
      "description": "Consecutive sales without disputes"
    },
    "is_founding_fan": {
      "type": "boolean",
      "default": false,
      "description": "Early beta user flag"
    },
    "points_last_updated": {
      "type": "string",
      "description": "ISO timestamp of last points activity"
    }
  },
  "required": []
}