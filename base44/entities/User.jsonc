{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect account ID \u2014 set after seller onboarding"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "strike_count": {
      "type": "number",
      "default": 0
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string",
      "description": "Profile banner image URL"
    },
    "persona_name": {
      "type": "string"
    },
    "persona_style": {
      "type": "string"
    },
    "verified_fan": {
      "type": "boolean",
      "default": false
    },
    "peanut_points": {
      "type": "number",
      "default": 0,
      "description": "Current spendable Peanut Points balance"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "Lifetime total points earned (never decrements) \u2014 used for rank/leaderboard"
    },
    "peanut_level": {
      "type": "number",
      "default": 1,
      "description": "Current rank level (1-10)"
    },
    "peanut_rank": {
      "type": "string",
      "default": "Rookie Fan",
      "description": "Current rank label (e.g. Rookie Fan, Headliner)"
    },
    "trust_score": {
      "type": "number",
      "default": 50,
      "description": "Computed 0-100 trust score. Higher = more trustworthy."
    },
    "trust_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Earned trust badge keys (e.g. verified_seller, fast_transfer)"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unlocked achievement keys"
    },
    "seller_streak": {
      "type": "number",
      "default": 0,
      "description": "Consecutive successful transfers without failure"
    },
    "total_purchases": {
      "type": "number",
      "default": 0,
      "description": "Lifetime completed ticket purchases"
    },
    "total_sales": {
      "type": "number",
      "default": 0,
      "description": "Lifetime completed ticket sales"
    },
    "total_instant_listings": {
      "type": "number",
      "default": 0,
      "description": "Lifetime instant listings verified by PG"
    },
    "total_live_upgrades": {
      "type": "number",
      "default": 0,
      "description": "Lifetime live upgrade transactions (buy or sell)"
    },
    "total_fast_transfers": {
      "type": "number",
      "default": 0,
      "description": "Count of transfers completed within fast threshold"
    },
    "total_disputes": {
      "type": "number",
      "default": 0,
      "description": "Lifetime disputes caused by this seller"
    },
    "total_failed_transfers": {
      "type": "number",
      "default": 0,
      "description": "Lifetime transfers that failed/expired without seller action"
    },
    "total_cancelled_sales": {
      "type": "number",
      "default": 0,
      "description": "Lifetime cancelled/expired sales"
    },
    "confirmed_fraud_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times confirmed fraudulent behavior \u2014 excludes from donations and leaderboard"
    },
    "total_donations_made": {
      "type": "number",
      "default": 0,
      "description": "Lifetime seat donations submitted"
    },
    "false_dispute_count": {
      "type": "number",
      "default": 0,
      "description": "Times buyer filed a false or unfounded dispute"
    },
    "is_founding_fan": {
      "type": "boolean",
      "default": false,
      "description": "Founding fan status \u2014 grants founding_fan trust badge"
    },
    "has_seen_onboarding": {
      "type": "boolean",
      "default": false,
      "description": "Persists onboarding completion across devices"
    },
    "points_last_updated": {
      "type": "string",
      "description": "ISO timestamp of last points/trust update"
    },
    "referral_code": {
      "type": "string",
      "description": "This user's shareable referral code"
    },
    "referred_by": {
      "type": "string",
      "description": "Referral code used at signup"
    },
    "seller_transfer_reliability": {
      "type": "number",
      "description": "0-100 seller reliability score. Updated after each transfer outcome.",
      "default": 70
    },
    "transfer_success_count": {
      "type": "number",
      "default": 0,
      "description": "Lifetime successful transfers"
    },
    "transfer_fail_count": {
      "type": "number",
      "default": 0,
      "description": "Lifetime failed/disputed transfers"
    },
    "transfer_expired_count": {
      "type": "number",
      "default": 0,
      "description": "Times verification expired before a sale"
    },
    "transfer_false_claim_count": {
      "type": "number",
      "default": 0,
      "description": "Times seller claimed transfer available but AI/admin/buyer dispute proved otherwise"
    },
    "last_pi_attempt_at": {
      "type": "string",
      "description": "ISO timestamp of last payment intent creation attempt \u2014 used for rate limiting"
    },
    "pi_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Total payment intent creation attempts \u2014 fraud signal"
    }
  },
  "required": []
}