{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "strikes": {
      "type": "number",
      "default": 0
    },
    "notification_new_message": {
      "type": "boolean",
      "default": true
    },
    "notification_sale": {
      "type": "boolean",
      "default": true
    },
    "notification_price_drop": {
      "type": "boolean",
      "default": false
    },
    "notif_listing_sold": {
      "type": "boolean",
      "default": true
    },
    "notif_transfer_updates": {
      "type": "boolean",
      "default": true
    },
    "notif_upgrade_alerts": {
      "type": "boolean",
      "default": true
    },
    "notif_nearby_events": {
      "type": "boolean",
      "default": false
    },
    "notif_fan_zone": {
      "type": "boolean",
      "default": false
    },
    "push_token": {
      "type": "string",
      "description": "Device push token for FCM/APNs/Expo. Stored after user grants notification permission."
    },
    "push_token_updated_at": {
      "type": "string",
      "description": "ISO timestamp of when push_token was last set"
    }
  },
  "required": []
}