{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "bio": {
      "type": "string",
      "description": "User bio / persona description"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "banner_url": {
      "type": "string",
      "description": "Profile banner URL"
    },
    "favorite_team": {
      "type": "string"
    },
    "peanut_points": {
      "type": "number",
      "default": 0,
      "description": "Current Peanut Points balance (can change with activity)"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "All-time accumulated points \u2014 used for level/rank calculation"
    },
    "peanut_level": {
      "type": "number",
      "default": 1,
      "description": "Current fan level (1\u201310)"
    },
    "peanut_rank": {
      "type": "string",
      "default": "Rookie Fan",
      "description": "Current fan rank label"
    },
    "trust_score": {
      "type": "number",
      "default": 50,
      "description": "Trust score 0\u2013100, affects trust badges"
    },
    "trust_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Earned trust badge keys e.g. trusted_seller, fast_fulfillment"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unlocked achievement keys"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code for this user"
    },
    "referred_by": {
      "type": "string",
      "description": "Email of user who referred this user"
    },
    "total_purchases": {
      "type": "number",
      "default": 0
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "total_instant_listings": {
      "type": "number",
      "default": 0
    },
    "seller_streak": {
      "type": "number",
      "default": 0,
      "description": "Consecutive successful sales without disputes"
    },
    "points_last_updated": {
      "type": "string",
      "description": "ISO timestamp of last points activity"
    }
  }
}