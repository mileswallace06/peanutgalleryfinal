{
  "name": "BugReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "fixed",
        "verified"
      ],
      "default": "open"
    },
    "affected_page": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "screenshot_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}