{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name of the event"
    },
    "artist": {
      "type": "string",
      "description": "Performer name"
    },
    "venue": {
      "type": "string",
      "description": "Venue name"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "e.g. AZ"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Event start time"
    },
    "category": {
      "type": "string",
      "enum": [
        "concert",
        "sports",
        "theater",
        "comedy",
        "other"
      ],
      "description": "Event category"
    },
    "image_url": {
      "type": "string",
      "description": "Hero image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "ended"
      ],
      "default": "upcoming"
    },
    "is_beta_live": {
      "type": "boolean",
      "default": false,
      "description": "Force-marks event as live for beta testing \u2014 listings appear in Upgrades tab regardless of date"
    },
    "venue_lat": {
      "type": "number"
    },
    "venue_lng": {
      "type": "number"
    },
    "geo_radius_meters": {
      "type": "number",
      "default": 500
    },
    "tm_id": {
      "type": "string",
      "description": "Ticketmaster event ID for externally sourced events"
    },
    "tm_url": {
      "type": "string",
      "description": "Ticketmaster event URL for externally sourced events"
    }
  },
  "required": [
    "title",
    "venue",
    "date"
  ]
}