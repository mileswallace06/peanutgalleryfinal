{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name of the event"
    },
    "artist": {
      "type": "string",
      "description": "Performer name"
    },
    "venue": {
      "type": "string",
      "description": "Venue name"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "e.g. AZ"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy field \u2014 UTC ISO string. Prefer event_start_utc for new events."
    },
    "event_start_local": {
      "type": "string",
      "description": "Local date/time at the venue as ISO string WITHOUT timezone offset, e.g. 2026-05-08T19:00:00. Used for display and initial data entry."
    },
    "event_start_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Canonical UTC start time as ISO string. Derived from event_start_local + venue_timezone. All live/expired logic compares against this."
    },
    "venue_timezone": {
      "type": "string",
      "description": "IANA timezone of the venue, e.g. America/Phoenix, America/Los_Angeles, America/New_York. REQUIRED for accurate live-window calculation."
    },
    "duration_hours": {
      "type": "number",
      "description": "How many hours after start time the event is considered live. Defaults: concert/sports=4h, theater/comedy=3h."
    },
    "category": {
      "type": "string",
      "enum": [
        "concert",
        "sports",
        "theater",
        "comedy",
        "other"
      ],
      "description": "Event category \u2014 also controls default duration_hours"
    },
    "image_url": {
      "type": "string",
      "description": "Hero image URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "ended"
      ],
      "default": "upcoming"
    },
    "is_beta_live": {
      "type": "boolean",
      "default": false,
      "description": "Force-marks event as live for beta testing \u2014 listings appear in Upgrades tab regardless of date"
    },
    "venue_lat": {
      "type": "number"
    },
    "venue_lng": {
      "type": "number"
    },
    "geo_radius_meters": {
      "type": "number",
      "default": 500
    },
    "tm_id": {
      "type": "string",
      "description": "Ticketmaster event ID for externally sourced events"
    },
    "tm_url": {
      "type": "string",
      "description": "Ticketmaster event URL for externally sourced events"
    }
  },
  "required": [
    "title",
    "venue",
    "date"
  ]
}