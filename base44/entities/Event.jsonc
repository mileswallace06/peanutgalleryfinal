{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name of the event"
    },
    "artist": {
      "type": "string",
      "description": "Performer name"
    },
    "venue": {
      "type": "string",
      "description": "Venue name"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "e.g. AZ"
    },
    "search_text_normalized": {
      "type": "string",
      "description": "Pre-normalized search blob (title, artist, venue, city, state) for server-side $regex keyword search. Generated by syncTMEvent and the M0.2 backfill. Diacritic-insensitive, punctuation-stripped, whitespace-collapsed, lowercased."
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy field \u2014 UTC ISO string. Prefer event_start_utc for new events."
    },
    "event_start_local": {
      "type": "string",
      "description": "Local date/time at the venue as ISO string WITHOUT timezone offset, e.g. 2026-05-08T19:00:00."
    },
    "event_start_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Canonical UTC start time as ISO string."
    },
    "venue_timezone": {
      "type": "string",
      "description": "IANA timezone of the venue, e.g. America/Phoenix."
    },
    "duration_hours": {
      "type": "number",
      "description": "How many hours after start time the event is considered live."
    },
    "category": {
      "type": "string",
      "enum": [
        "concert",
        "sports",
        "theater",
        "comedy",
        "other"
      ]
    },
    "image_url": {
      "type": "string",
      "description": "Raw Ticketmaster event artwork URL (kept untouched for traceability)."
    },
    "hero_image_url": {
      "type": "string",
      "description": "Resolved hero image actually displayed by the UI (Ticketmaster artwork \u2192 Venue hero). Empty/missing \u21d2 render the GeneratedHero component. Written at sync time."
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "ended"
      ],
      "default": "upcoming"
    },
    "is_beta_live": {
      "type": "boolean",
      "default": false
    },
    "venue_lat": {
      "type": "number"
    },
    "venue_lng": {
      "type": "number"
    },
    "geo_radius_meters": {
      "type": "number",
      "default": 500
    },
    "tm_id": {
      "type": "string"
    },
    "tm_url": {
      "type": "string"
    },
    "tm_venue_id": {
      "type": "string",
      "description": "Ticketmaster's stable venue identifier. FK to Venue.tm_venue_id. The permanent relationship \u2014 never rely on venue name."
    },
    "transfer_window_status": {
      "type": "string",
      "enum": [
        "unknown",
        "open",
        "closing_soon",
        "closed",
        "manually_verified_open",
        "manually_verified_closed"
      ],
      "default": "unknown",
      "description": "Whether ticket transfers are currently available for this event"
    },
    "transfer_window_closes_at": {
      "type": "string",
      "description": "ISO timestamp \u2014 when the transfer window is expected to close. Null if unknown."
    },
    "transfer_window_source": {
      "type": "string",
      "enum": [
        "ticketmaster",
        "seatgeek",
        "axs",
        "mlb",
        "manual_admin",
        "user_reported",
        "inferred"
      ],
      "description": "Source of the transfer window status"
    },
    "transfer_window_confidence": {
      "type": "number",
      "description": "Legacy confidence score 0\u2013100 (max of open/closed). Kept in sync with the directional scores."
    },
    "transfer_open_confidence_score": {
      "type": "number",
      "description": "Confidence 0\u2013100 that transfers are currently AVAILABLE (window open)."
    },
    "transfer_closed_confidence_score": {
      "type": "number",
      "description": "Confidence 0\u2013100 that transfers are currently CLOSED (window closed). >=90 \u2192 hide listings & disable upgrades; 70-89 \u2192 closing soon."
    },
    "transfer_confidence_recommendation": {
      "type": "string",
      "enum": [
        "open",
        "likely_open",
        "closing_soon",
        "closed",
        "unknown",
        "admin_review"
      ],
      "description": "Engine recommendation derived from directional scores + stability. admin_review = conflicting/ambiguous signals."
    },
    "transfer_confidence_evidence": {
      "type": "object",
      "description": "Explainable AI: per-source signed contribution to the OPEN confidence (positive = supports open, negative = supports closed). Values need not total 100.",
      "properties": {
        "official_partner": {
          "type": "number"
        },
        "manual_verification": {
          "type": "number"
        },
        "historical_success": {
          "type": "number"
        },
        "historical_failures": {
          "type": "number"
        },
        "community_reports_positive": {
          "type": "number"
        },
        "community_reports_negative": {
          "type": "number"
        },
        "time_inference": {
          "type": "number"
        },
        "venue_patterns": {
          "type": "number"
        },
        "platform_patterns": {
          "type": "number"
        },
        "seller_history": {
          "type": "number"
        },
        "buyer_history": {
          "type": "number"
        }
      }
    },
    "transfer_confidence_momentum": {
      "type": "object",
      "description": "Confidence momentum applied this scan (limits wild swings unless authoritative).",
      "properties": {
        "open": {
          "type": "number",
          "description": "Change applied to open score this scan (null if first scan)"
        },
        "closed": {
          "type": "number",
          "description": "Change applied to closed score this scan (null if first scan)"
        },
        "bypassed": {
          "type": "boolean",
          "description": "True if momentum was bypassed by an authoritative source (manual/official)"
        }
      }
    },
    "transfer_confidence_reason": {
      "type": "string",
      "description": "Short human-readable summary of the contributing signals."
    },
    "transfer_confidence_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the last Transfer Confidence Engine recalculation."
    },
    "upgrade_eligibility_status": {
      "type": "string",
      "enum": [
        "eligible",
        "limited",
        "unknown",
        "not_eligible"
      ],
      "default": "unknown",
      "description": "Overall upgrade eligibility derived from transfer window status"
    },
    "last_transfer_check_at": {
      "type": "string",
      "description": "ISO timestamp of the last transfer window check"
    },
    "admin_transfer_notes": {
      "type": "string",
      "description": "Admin notes on transfer window status"
    }
  },
  "required": [
    "title",
    "venue",
    "date"
  ]
}