{
  "name": "BetaFeedbackEvent",
  "type": "object",
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "submitter_user_id": {
      "type": "string",
      "description": "Server-written authenticated submitter ID. Derived exclusively from user.id inside submitFeedback. Never trusted from client input."
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "bug",
        "confused",
        "love",
        "idea"
      ],
      "description": "Type of feedback submitted"
    },
    "page": {
      "type": "string",
      "maxLength": 500,
      "description": "Page path where feedback was submitted"
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "screenshot_url": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "submitter_user_id",
    "feedback_type"
  ]
}