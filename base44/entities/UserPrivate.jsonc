{
  "name": "UserPrivate",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK to User \u2014 primary key. Private; never exposed via PublicProfile."
    },
    "user_email": {
      "type": "string",
      "description": "Owner email \u2014 RLS key for owner reads."
    },
    "public_profile_id": {
      "type": "string",
      "description": "Opaque public_profile_id (pp_<uuid>) pointing to this user's PublicProfile. This is the ONLY durable user_id \u2194 public_profile_id mapping and it is private."
    },
    "phone": {
      "type": "string"
    },
    "has_seen_onboarding": {
      "type": "boolean",
      "default": false
    },
    "points_last_updated": {
      "type": "string"
    },
    "referred_by": {
      "type": "string"
    },
    "preferences": {
      "type": "object"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "user_email"
  ]
}